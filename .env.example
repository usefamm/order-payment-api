# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/order_payment

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d

# Redis (access-token store for server-side revocation / logout)
# Leave unset to fall back to an in-memory store (fine for tests).
REDIS_URL=redis://127.0.0.1:6379
